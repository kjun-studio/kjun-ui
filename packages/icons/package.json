{
  "name": "@kjun-ui/icons",
  "version": "0.3.0",
  "license": "MIT",
  "homepage": "https://ui.kjun.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjun-studio/kjun-ui.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/kjun-studio/kjun-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Complete Tabler icon data with selective imports for KJUN UI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./defaults": {
      "import": {
        "types": "./dist/defaults.d.ts",
        "default": "./dist/defaults.js"
      },
      "require": {
        "types": "./dist/defaults.d.cts",
        "default": "./dist/defaults.cjs"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      },
      "require": {
        "types": "./dist/metadata.d.cts",
        "default": "./dist/metadata.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.ts",
        "default": "./dist/all.js"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
