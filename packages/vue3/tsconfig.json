{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "vue": ["../../node_modules/vue3-runtime"],
      "vue/jsx-runtime": ["../../node_modules/vue3-runtime/jsx-runtime"]
    }
  },
  "files": ["src/index.ts"]
}
