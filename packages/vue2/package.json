{
  "name": "@kjun-ui/vue2",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://ui.kjun.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjun-studio/kjun-ui.git",
    "directory": "packages/vue2"
  },
  "bugs": {
    "url": "https://github.com/kjun-studio/kjun-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "KJUN UI components for Vue 2 with shared geometry and interaction contracts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@kjun-ui/tokens": "0.3.1",
    "@kjun-ui/icons": "0.3.1"
  },
  "peerDependencies": {
    "vue": "^2.6.14"
  }
}
