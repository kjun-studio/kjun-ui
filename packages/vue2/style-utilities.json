      "up-bg-strong": "var(--_kjun-price-up-bg-strong)",
      "down": "var(--_kjun-price-down)",
      "down-light": "var(--_kjun-price-down-light)",
      "down-bg": "var(--_kjun-price-down-bg)",
      "down-bg-strong": "var(--_kjun-price-down-bg-strong)",
      "neutral": "var(--_kjun-price-neutral)",
