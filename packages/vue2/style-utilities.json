      "bg": "var(--_kjun-card-bg)",
      "bg-hover": "var(--_kjun-card-bg-hover)",
      "border": "var(--_kjun-role-card-border)"
    },
    "input": {
      "bg": "var(--_kjun-input-bg)",
      "border": "var(--_kjun-input-border)",
      "border-focus": "var(--_kjun-input-border-focus)",
      "placeholder": "var(--_kjun-input-placeholder)"
    },
    "table": {
      "header-bg": "var(--_kjun-table-header-bg)",
      "row-hover": "var(--_kjun-table-row-hover)",
      "border": "var(--_kjun-table-border)"
    },
    "overlay": {
