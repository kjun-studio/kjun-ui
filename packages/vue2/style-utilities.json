      "DEFAULT": "var(--_kjun-skeleton)",
      "shine": "var(--_kjun-skeleton-shine)"
    },
    "chart": {
      "grid": "var(--_kjun-chart-grid)",
      "axis": "var(--_kjun-chart-axis)",
      "tooltip-bg": "var(--_kjun-chart-tooltip-bg)",
      "tooltip-text": "var(--_kjun-chart-tooltip-text)"
    },
    "surface": {
      "card": "var(--_kjun-card-bg)",
      "background": "var(--_kjun-surface-background)",
      "dark": "var(--_kjun-bg-tertiary)",
      "dark-bg": "var(--_kjun-bg-primary)"
    },
    "selected-bg": "var(--_kjun-selected-bg)",
    "focus-ring": "var(--_kjun-focus-ring)",
    "on-brand": "var(--_kjun-on-brand)",
    "on-danger": "var(--_kjun-on-danger)",
    "on-success": "var(--_kjun-on-success)",
    "on-warning": "var(--_kjun-on-warning)"
  },
  "keyframes": {
    "fade-in": {
      "0%": {
        "opacity": "0"
      },
      "100%": {
        "opacity": "1"
      }
    },
    "fade-out": {
      "0%": {
        "opacity": "1"
      },
      "100%": {
        "opacity": "0"
      }
    },
    "slide-up": {
      "0%": {
        "transform": "translateY(8px)",
        "opacity": "0"
      },
      "100%": {
        "transform": "translateY(0)",
        "opacity": "1"
      }
    },
    "slide-down": {
      "0%": {
        "transform": "translateY(-8px)",
        "opacity": "0"
      },
      "100%": {
        "transform": "translateY(0)",
        "opacity": "1"
      }
    },
    "pulse-soft": {
      "0%, 100%": {
        "opacity": "1"
      },
      "50%": {
        "opacity": "0.6"
      }
    },
    "skeleton": {
      "0%": {
        "backgroundPosition": "200% 0"
      },
      "100%": {
        "backgroundPosition": "-200% 0"
      }
    },
    "spin": {
      "0%": {
        "transform": "rotate(0deg)"
      },
      "100%": {
        "transform": "rotate(360deg)"
      }
    }
  },
  "animation": {
    "fade-in": "fade-in 200ms ease-out",
    "fade-out": "fade-out 150ms ease-in",
    "slide-up": "slide-up 200ms cubic-bezier(0.16, 1, 0.3, 1)",
    "slide-down": "slide-down 200ms cubic-bezier(0.16, 1, 0.3, 1)",
    "pulse-soft": "pulse-soft 2s ease-in-out infinite",
    "skeleton": "skeleton 1.5s ease-in-out infinite",
    "spin": "spin 1s linear infinite"
  },
  "minHeight": {
    "screen": "100vh"
  },
  "maxWidth": {
    "screen-sm": "640px",
    "screen-md": "768px",
    "screen-lg": "1024px",
    "screen-xl": "1280px",
    "screen-2xl": "1536px"
  }
}
