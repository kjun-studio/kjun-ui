{
  "iconSizes": {
    "compact": 12,
    "small": 14,
    "default": 16,
    "medium": 18,
    "large": 20,
    "feature": 24
  },
  "modal": {
    "closeSize": 32,
    "closeIconSize": {
      "$ref": "iconSizes.medium"
    }
  },
  "table": {
    "selectionSize": 16,
    "sortIconSize": {
      "$ref": "iconSizes.compact"
    },
    "sortedIconSize": {
      "$ref": "iconSizes.small"
    },
    "searchWidth": 200
  },
  "extensions": {
    "spinner": {
      "sizes": {
        "xs": 12,
        "sm": 16,
        "md": 24,
        "lg": 32,
        "xl": 48
      },
      "strokeWidths": {
        "xs": 2,
        "sm": 2,
        "md": 3,
        "lg": 4,
        "xl": 4
      }
    },
    "progress": {
      "heights": {
        "sm": 4,
        "md": 8,
        "lg": 12
      },
      "circle": {
        "sm": { "size": 24, "stroke": 4 },
        "md": { "size": 48, "stroke": 4 },
        "lg": { "size": 64, "stroke": 6 }
      }
    },
    "iconToggle": {
      "compactSize": {
        "$ref": "button.heights.xs"
      },
      "sizes": {
        "xs": { "$ref": "extensions.iconToggle.compactSize" },
        "sm": { "$ref": "button.heights.xs" },
        "md": { "$ref": "button.heights.sm" },
        "lg": { "$ref": "button.heights.md" },
        "xl": { "$ref": "button.heights.lg" }
      },
      "radii": {
        "xs": { "$ref": "button.radii.xs" },
        "sm": { "$ref": "button.radii.xs" },
        "md": { "$ref": "button.radii.sm" },
        "lg": { "$ref": "button.radii.md" },
        "xl": { "$ref": "button.radii.lg" }
      }
    },
    "selection": {
      "iconSize": {
        "$ref": "iconSizes.default"
      },
      "dotSize": 8,
      "minimumHeight": 36
    },
    "chip": {
      "iconSizes": {
        "sm": { "$ref": "iconSizes.small" },
        "md": { "$ref": "iconSizes.default" },
        "lg": { "$ref": "iconSizes.medium" }
      },
      "removeIconSizes": {
        "sm": { "$ref": "iconSizes.compact" },
        "md": { "$ref": "iconSizes.small" },
        "lg": { "$ref": "iconSizes.default" }
      }
    },
    "image": {
      "fallbackIconSize": {
        "$ref": "iconSizes.feature"
      }
    },
    "avatar": {
      "fallbackIconSizes": {
        "xs": { "$ref": "iconSizes.compact" },
        "sm": { "$ref": "iconSizes.small" },
        "md": { "$ref": "iconSizes.medium" },
        "lg": { "$ref": "iconSizes.feature" },
        "xl": 32
      },
      "fallbackIconSize": {
        "$ref": "extensions.avatar.fallbackIconSizes.md"
      }
    },
    "form": {
      "messageIconSize": {
        "$ref": "iconSizes.default"
      }
    },
    "list": {
      "iconSize": {
        "$ref": "iconSizes.large"
      }
    },
    "alert": {
      "iconSizes": {
        "sm": {
          "$ref": "iconSizes.default"
        },
        "md": {
          "$ref": "iconSizes.medium"
        }
      },
      "closeIconSize": {
        "$ref": "iconSizes.default"
      }
    },
    "breadcrumb": {
      "iconSize": {
        "$ref": "iconSizes.small"
      },
      "separatorSize": {
        "$ref": "iconSizes.compact"
      },
      "gap": {
        "$ref": "dimension.value8"
      },
      "iconGap": {
        "$ref": "dimension.value4"
      },
      "labelMaxWidth": 200
    },
    "pagination": {
      "iconSize": {
        "$ref": "iconSizes.default"
      }
    },
    "menu": {
      "minimumWidth": 160,
      "listMaxHeight": 240,
      "iconSize": {
        "$ref": "iconSizes.default"
      },
      "dividerHeight": {
        "$ref": "border.defaultWidth"
      }
    },
    "floating": {
      "maxHeight": 480,
      "viewportInset": {
        "$ref": "dimension.value8"
      },
      "anchorGap": {
        "$ref": "dimension.value8"
      },
      "fieldGap": {
        "$ref": "dimension.value4"
      }
    },
    "tooltip": {
      "maxWidths": { "sm": 192, "md": 256, "lg": 320 },
      "maxWidth": { "$ref": "extensions.tooltip.maxWidths.md" },
      "arrowSize": 8
    },
    "drawer": {
      "width": 400,
      "closeSize": {
        "$ref": "modal.closeSize"
      },
      "closeIconSize": {
        "$ref": "iconSizes.default"
      }
    },
    "scrollbar": {
      "width": 6
    },
    "scrollFade": {
      "width": 24
    },
    "carousel": {
      "peek": { "$ref": "dimension.value24" },
      "indicatorSize": { "$ref": "dimension.value6" },
      "indicatorActiveWidth": { "$ref": "dimension.value16" },
      "indicatorPress": { "$ref": "dimension.value24" },
      "indicatorPressWidth": { "$ref": "dimension.value20" },
      "indicatorOffset": { "$ref": "dimension.value12" },
      "controlInset": { "$ref": "dimension.value8" },
      "focusRadius": { "$ref": "radius.radius12" },
      "headerGap": { "$ref": "dimension.value12" },
      "headerControlsGap": { "$ref": "dimension.value8" },
      "overlayPaddingX": { "$ref": "dimension.value8" }
    },
    "slider": {
      "minimumWidth": 100
    },
    "calendar": {
      "width": 312,
      "padding": { "$ref": "dimension.value12" },
      "headerHeight": 36,
      "navSize": 36,
      "titleGap": { "$ref": "dimension.value4" },
      "daySize": 40,
      "rowGap": { "$ref": "dimension.value2" },
      "weekdayHeight": 32,
      "monthHeight": 52,
      "monthGap": { "$ref": "dimension.value8" },
      "yearHeight": 32,
      "yearGap": { "$ref": "dimension.value6" },
      "footerGap": { "$ref": "dimension.value8" },
      "radius": { "$ref": "radius.radius16" },
      "monthRadius": { "$ref": "radius.radius12" },
      "todayRing": 1.5,
      "rangeBleed": 3
    },
    "financial": {
      "warningIconSize": {
        "$ref": "iconSizes.compact"
      },
      "warningTargetSize": {
        "$ref": "dimension.value24"
      },
      "markSizes": {
        "sm": {
          "$ref": "iconSizes.compact"
        },
        "md": {
          "$ref": "iconSizes.small"
        },
        "lg": {
          "$ref": "iconSizes.default"
        }
      },
      "heartMarkSizes": {
        "sm": {
          "$ref": "iconSizes.small"
        },
        "md": {
          "$ref": "iconSizes.default"
        },
        "lg": {
          "$ref": "iconSizes.medium"
        }
      },
      "progressHeight": 6,
      "progressMinimumWidth": 60,
      "progressLabelWidth": 32,
      "sparklineWidth": 80,
      "sparklineHeight": 24,
      "sparklineStrokeWidth": 1.5,
      "sparklineDotSize": 5,
      "sparklineLoneDotSize": 4,
      "sparklineBaselineWidth": 1,
      "sparklineBarMinHeight": { "$ref": "dimension.value2" },
      "sparklineBarGap": { "$ref": "dimension.value2" },
      "sparklineDash": { "$ref": "dimension.value2" },
      "sparklineDashGap": { "$ref": "dimension.value3" },
      "priceSkeletonWidth": 64,
      "priceSkeletonHeight": 16,
      "signedSkeletonWidth": 48
    },
    "marketTable": {
      "sortIconSize": {
        "$ref": "iconSizes.small"
      },
      "sparklineWidth": 72,
      "sparklineHeight": 22,
      "valueSkeletonWidth": 56,
      "actionSkeletonWidth": 32,
      "headerSkeletonHeight": 14
    },
    "marketList": {
      "minimumHeight": 72,
      "mobileQuoteMinimumWidth": 102,
      "changeSkeletonWidth": 56
    },
    "skeleton": {
      "lineHeights": {
        "md": 16
      },
      "avatarSize": 48,
      "tableLineHeight": 14,
      "blockHeight": 100,
      "listHeights": {
        "market": {
          "$ref": "extensions.marketList.minimumHeight"
        },
        "compact": 56,
        "notification": 64
      },
      "quoteWidth": 88,
      "detailWidth": 56,
      "formLabelWidth": 96,
      "identityWidth": 128,
      "identityHeight": 20,
      "listAvatarSize": 36
    },
    "chartSkeleton": {
      "height": 240,
      "donutThickness": 22,
      "axisWidth": 40,
      "tickLabelWidth": 28,
      "labelGap": { "$ref": "dimension.value8" }
    },
    "tableCard": {
      "titleSkeletonWidth": 96,
      "titleSkeletonHeight": 20,
      "badgeSkeletonWidth": 64,
      "fieldSkeletonHeight": 18,
      "actionSkeletonWidth": 72,
      "actionSkeletonHeight": 24
    },
    "kpiHero": {
      "deltaSkeletonWidth": 220,
      "secondarySkeletonWidth": 55,
      "descriptionSkeletonWidth": 58
    },
    "kpiRow": {
      "dotSize": 4,
      "labelSkeletonWidth": 80,
      "valueSkeletonWidth": 80,
      "segmentSkeletonWidth": 48,
      "descriptionSkeletonWidth": 90
    }
  }
}
