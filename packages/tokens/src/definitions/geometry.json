    "value16": 16,
    "value20": 20,
    "value24": 24,
    "value28": 28,
    "value32": 32,
    "value40": 40,
    "value48": 48,
    "value56": 56,
    "value64": 64,
    "value3": 3,
    "value80": 80,
    "value96": 96
