    "tooltipExit": { "$ref": "motion.instant" },
    "toastEnter": { "$ref": "motion.fast" },
    "toastExit": { "$ref": "motion.quick" },
    "collapse": { "$ref": "motion.fast" },
    "indicator": { "$ref": "motion.fast" },
