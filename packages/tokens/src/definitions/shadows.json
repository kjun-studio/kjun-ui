{
  "elevation": {
    "flat": [],
    "raised": [
      {
        "offsetX": 0,
        "offsetY": 1,
        "blurRadius": 2,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadowSubtle"
      }
    ],
    "handle": [
      {
        "offsetX": 0,
        "offsetY": 1,
        "blurRadius": 3,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadow"
      }
    ],
    "lifted": [
      {
        "offsetX": 0,
        "offsetY": 2,
        "blurRadius": 8,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadowSubtle"
      }
    ],
    "floating": [
      {
        "offsetX": 0,
        "offsetY": 6,
        "blurRadius": 16,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadow"
      },
      {
        "offsetX": 0,
        "offsetY": 1,
        "blurRadius": 3,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadowSubtle"
      }
    ],
    "docked": [
      {
        "offsetX": 0,
        "offsetY": -8,
        "blurRadius": 24,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadowSubtle"
      },
      {
        "offsetX": 0,
        "offsetY": -1,
        "blurRadius": 0,
        "spreadDistance": 0,
        "inset": false,
        "colorRole": "shadowSubtle"
      }
    ]
  },
  "card": {
    "elevation": {
      "flat": {
        "$ref": "elevation.flat"
      },
      "raised": {
        "$ref": "elevation.raised"
      }
    }
  },
  "modal": {
    "elevation": {
      "$ref": "elevation.lifted"
    }
  },
  "extensions": {
    "menu": {
      "elevation": {
        "$ref": "elevation.floating"
      }
    },
    "popover": {
      "elevation": {
        "$ref": "elevation.floating"
      }
    },
    "drawer": {
      "elevation": {
        "$ref": "elevation.lifted"
      }
    },
    "toast": {
      "elevation": {
        "$ref": "elevation.floating"
      }
    },
    "switch": {
      "elevation": {
        "$ref": "elevation.handle"
      }
    },
    "slider": {
      "elevation": {
        "$ref": "elevation.handle"
      }
    },
    "tooltip": {
      "elevation": {
        "$ref": "elevation.flat"
      }
    },
    "bottomNavigation": {
      "elevation": {
        "$ref": "elevation.docked"
      }
    },
    "floatingNavigation": {
      "elevation": {
        "$ref": "elevation.floating"
      }
    },
    "fab": {
      "elevation": {
        "$ref": "elevation.lifted"
      }
    },
    "carousel": {
      "elevation": {
        "$ref": "elevation.lifted"
      }
    }
  }
}
