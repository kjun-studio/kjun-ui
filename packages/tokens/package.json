{
  "name": "@kjun-ui/tokens",
  "version": "0.3.0",
  "license": "MIT",
  "homepage": "https://ui.kjun.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjun-studio/kjun-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/kjun-studio/kjun-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared KJUN UI geometry, interaction types and color-role contracts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./tokens.json": "./dist/tokens.json",
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    }
  },
  "dependencies": {
    "@kjun-ui/icons": "0.3.0"
  }
}
