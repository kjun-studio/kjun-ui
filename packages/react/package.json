{
  "name": "@kjun-ui/react",
  "version": "0.3.0",
  "license": "MIT",
  "homepage": "https://ui.kjun.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjun-studio/kjun-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/kjun-studio/kjun-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "KJUN UI components for React with shared geometry and interaction contracts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@kjun-ui/tokens": "0.3.0",
    "react-aria-components": "1.21.1",
    "@kjun-ui/icons": "0.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
