{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/react/src/**/*.tsx",
    "packages/react/src/**/*.ts",
    "packages/native/src/**/*.tsx",
    "packages/native/src/**/*.ts",
    "previews/**/*.tsx",
    "previews/**/*.ts"
  ]
}
